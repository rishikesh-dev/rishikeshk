rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public site content: anyone can read, only you (Console / admin) can write.
    match /portfolio/{doc} { allow read: if true; allow write: if false; }
    match /projects/{doc}  { allow read: if true; allow write: if false; }

    // Contact messages: anyone can create a valid one, nobody can read them here.
    match /messages/{doc} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'sentAt', 'source'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.+@.+')
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 4000
        && request.resource.data.sentAt is string
        && request.resource.data.source == 'portfolio';
    }
  }
}
