---
import { getProjectGroups } from '../lib/apps';
import { getRepo } from '../lib/github';
import { fsDoc } from '../lib/firestore';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import Pubspec from '../components/Pubspec.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const { featured, upcoming, others } = await getProjectGroups();
// Only fetch GitHub metadata for projects that actually render as feature rows.
const repos = await Promise.all(featured.map((project) => getRepo(project.data.githubUrl)));
const bio = await fsDoc('portfolio/bio');
---
<Base>
  <header class="hero" id="home">
    <div>
      <p class="label"><b>01</b>Flutter Developer, India</p>
      <h1><span><i>Apps</i></span><span><i>With</i></span><span><i>Purpose<em>.</em></i></span></h1>
      <p class="intro">I design and develop thoughtful mobile apps with Flutter. From personal tools to productivity apps, I focus on clean code, solid architecture and real-world usability.</p>
      <div class="cta-row"><a class="btn" href="#work">View Projects</a><a class="btn line" href="#contact">Contact Me</a></div>
    </div>
    <img class="sketch" src="/images/sketch.jpg" width=744 height=562 alt="Pencil sketch of a developer typing on a laptop at a desk with a lamp and a plant" fetchpriority="high" />
  </header>

  <section class="s" id="work">
    <p class="label"><b>02</b>Featured Works</p>
    {featured.length > 0
      ? featured.map((p, i) => <ProjectRow id={p.id} data={p.data} flip={i % 2 === 1} repo={repos[i]} />)
      : <p class="empty-note">{others.length + upcoming.length > 0 ? 'Nothing is featured right now. Browse every project below.' : 'No projects are published yet.'}</p>}
    {others.length > 0 && (
      <div class="more project-index">
        <h3>More projects</h3>
        <div class="index">
          {others.map((p, i) => <ProjectIndex project={p} index={i} />)}
        </div>
      </div>
    )}
    {upcoming.length > 0 && (
      <div class="more">
        <h3>More on the way</h3>
        <div class="soon">
          {upcoming.map((p) => (
            <article class="ph">
              <span class="st">Coming soon</span>
              <div>
                <h4><a href={`/apps/${p.id}/`}>{p.data.title}</a></h4>
                {p.data.summary && <p>{p.data.summary}</p>}
              </div>
              <span class="cat">{p.data.kind}</span>
            </article>
          ))}
        </div>
      </div>
    )}
  </section>

  <section class="s about" id="about">
    <div><p class="label"><b>03</b>About</p><q>I build apps the way I want to use them: fast, simple and made to last.</q></div>
    <dl>
      <dt>Based in</dt><dd>{site.location}</dd>
      <dt>How I work</dt><dd>Solo. You talk to the person who writes the code.</dd>
      <dt>What I do</dt><dd>My own apps, plus client work when it fits.</dd>
      {bio?.liveApps != null && <><dt>Live apps</dt><dd>{bio.liveApps}</dd></>}
      {bio?.projects != null && <><dt>Projects</dt><dd>{bio.projects}</dd></>}
      {bio?.downloads != null && <><dt>Downloads</dt><dd>{bio.downloads}</dd></>}
    </dl>
  </section>

  <section class="s" id="skills"><Pubspec /></section>

  <section class="s contact" id="contact">
    <p class="label"><b>05</b>Contact</p>
    <div class="contact-grid">
      <div>
        <h2>Let’s build something with purpose.</h2>
        <div class="alt">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.bookingUrl && <a href={site.bookingUrl} rel="noopener">Book a call</a>}
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
