# Copy this file to `.env` and fill in your own values for local builds.
# None of these are secrets: the site is static and reads public data at build
# time. Security for written data comes from firestore.rules, not from these.

# --- Firebase (public web config) ------------------------------------------
# Read from the Firebase Console: Project settings > Your apps > Web app.
# Both are required for any Firestore project content to appear.
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_API_KEY=
PUBLIC_WEB3FORMS_KEY=
# --- Contact form ----------------------------------------------------------
# Optional. Set to a form endpoint (Formspree, etc.) to receive contact
# messages there instead of Firestore. Leave empty to use Firestore or the
# visitor's email client.
PUBLIC_FORM_ENDPOINT=

# --- Booking link ----------------------------------------------------------
# Optional. Your scheduling link (Cal.com, Calendly, etc.).
PUBLIC_BOOKING_URL=

# --- Site ------------------------------------------------------------------
# Your final deployed address, used for canonical URLs and sitemaps.
SITE_URL=

# --- GitHub ----------------------------------------------------------------
# Optional. Raises the API rate limit during the build. GitHub Actions injects
# this automatically. Build-time only — never expose it through a PUBLIC_ var.
GITHUB_TOKEN=

# --- Local mock servers / tests (optional) ---------------------------------
# Leave these unset in production so the code uses the live Google/GitHub
# endpoints. Set them only to point the build at a local mock server.
# FIRESTORE_BASE should include /v1, e.g. http://127.0.0.1:8787/v1.
# GITHUB_API_BASE is the API root, e.g. http://127.0.0.1:8787/github.
FIRESTORE_BASE=
GITHUB_API_BASE=
