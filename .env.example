# Firebase public web config. These values are safe in the browser;
# security comes from firestore.rules.
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_API_KEY=

# Optional: use a form service instead of Firestore for contact messages.
PUBLIC_FORM_ENDPOINT=

# Booking link (Cal.com, Calendly, etc.).
PUBLIC_BOOKING_URL=

# Your final site address.
SITE_URL=

# Optional locally: raises the GitHub API limit. GitHub Actions provides this.
GITHUB_TOKEN=

# Optional overrides for local mock servers/tests.
# FIRESTORE_BASE should include /v1, e.g. http://127.0.0.1:8787/v1.
FIRESTORE_BASE=
GITHUB_API_BASE=
